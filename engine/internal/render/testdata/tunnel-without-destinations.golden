delete firewall ipv4 input filter
delete firewall ipv4 forward filter
delete firewall ipv4 name TUNNEL-INGRESS
delete firewall ipv6 input filter
delete firewall ipv6 forward filter
delete vpn ipsec
delete protocols static route
delete protocols bgp
delete interfaces ethernet eth0 ip adjust-mss
set firewall ipv4 input filter default-action "drop"
set firewall ipv4 input filter rule 1 action "drop"
set firewall ipv4 input filter rule 1 destination port "22,443"
set firewall ipv4 input filter rule 1 ipsec match-ipsec-in
set firewall ipv4 input filter rule 1 protocol "tcp"
set firewall ipv4 input filter rule 5 action "accept"
set firewall ipv4 input filter rule 5 state "established"
set firewall ipv4 input filter rule 5 state "related"
set firewall ipv4 input filter rule 20 action "accept"
set firewall ipv4 input filter rule 20 destination port "500"
set firewall ipv4 input filter rule 20 protocol "udp"
set firewall ipv4 input filter rule 21 action "accept"
set firewall ipv4 input filter rule 21 destination port "4500"
set firewall ipv4 input filter rule 21 protocol "udp"
set firewall ipv4 input filter rule 22 action "accept"
set firewall ipv4 input filter rule 22 protocol "esp"
set firewall ipv4 forward filter default-action "drop"
set firewall ipv4 forward filter rule 5 action "accept"
set firewall ipv4 forward filter rule 5 state "established"
set firewall ipv4 forward filter rule 5 state "related"
set firewall ipv4 forward filter rule 10 action "accept"
set firewall ipv4 forward filter rule 10 ipsec match-none-in
set firewall ipv4 forward filter rule 20 action "jump"
set firewall ipv4 forward filter rule 20 ipsec match-ipsec-in
set firewall ipv4 forward filter rule 20 jump-target "TUNNEL-INGRESS"
set firewall ipv4 name TUNNEL-INGRESS default-action "drop"
set firewall ipv4 name TUNNEL-INGRESS rule 5 action "accept"
set firewall ipv4 name TUNNEL-INGRESS rule 5 state "established"
set firewall ipv4 name TUNNEL-INGRESS rule 5 state "related"
set firewall ipv6 input filter default-action "drop"
set firewall ipv6 input filter rule 5 action "accept"
set firewall ipv6 input filter rule 5 state "established"
set firewall ipv6 input filter rule 5 state "related"
set firewall ipv6 input filter rule 10 action "accept"
set firewall ipv6 input filter rule 10 protocol "ipv6-icmp"
set firewall ipv6 forward filter default-action "drop"
set interfaces ethernet eth0 ip adjust-mss "1280"
set vpn ipsec ike-group ROUTER-IKE proposal 1 dh-group "14"
set vpn ipsec ike-group ROUTER-IKE proposal 1 encryption "aes256"
set vpn ipsec ike-group ROUTER-IKE proposal 1 hash "sha256"
set vpn ipsec ike-group ROUTER-IKE key-exchange "ikev2"
set vpn ipsec ike-group ROUTER-IKE lifetime "28800"
set vpn ipsec esp-group ROUTER-ESP lifetime "3600"
set vpn ipsec esp-group ROUTER-ESP pfs "dh-group14"
set vpn ipsec esp-group ROUTER-ESP proposal 1 encryption "aes256"
set vpn ipsec esp-group ROUTER-ESP proposal 1 hash "sha256"
set vpn ipsec authentication psk tunnel-0 id "203.0.113.10"
set vpn ipsec authentication psk tunnel-0 secret "golden-psk"
set vpn ipsec site-to-site peer tunnel-0 authentication mode "pre-shared-secret"
set vpn ipsec site-to-site peer tunnel-0 default-esp-group "ROUTER-ESP"
set vpn ipsec site-to-site peer tunnel-0 force-udp-encapsulation
set vpn ipsec site-to-site peer tunnel-0 ike-group "ROUTER-IKE"
set vpn ipsec site-to-site peer tunnel-0 local-address "any"
set vpn ipsec site-to-site peer tunnel-0 remote-address "203.0.113.10"
set vpn ipsec authentication psk tunnel-0 id "198.51.100.1"
set vpn ipsec site-to-site peer tunnel-0 authentication local-id "198.51.100.1"
set vpn ipsec site-to-site peer tunnel-0 tunnel 1 local prefix "0.0.0.0/0"
set vpn ipsec site-to-site peer tunnel-0 tunnel 1 remote prefix "172.31.0.0/16"
set vpn ipsec site-to-site peer tunnel-0 tunnel 2 local prefix "0.0.0.0/0"
set vpn ipsec site-to-site peer tunnel-0 tunnel 2 remote prefix "192.0.2.0/24"
