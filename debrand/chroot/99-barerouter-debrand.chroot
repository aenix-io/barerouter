#!/usr/bin/python3
# live-build chroot hook: replace the VyOS name in the user-visible text that
# vyos-1x installs. It runs after every package is in place, so the edited
# files are the ones that land in the squashfs.
#
# Each edit must match exactly as often as it expects, or the hook fails and
# takes the build with it. Copyright and licence notices are never touched;
# identifiers such as ID=vyos and /usr/libexec/vyos are code, not branding, and
# stay. The default login is the exception: a user types it at every console
# prompt, so it is replaced. docs/debranding.md lists both sides.
import glob
import json
import os
import re
import sys

NAME = "BareRouter"
REPO_URL = "https://github.com/aenix-io/barerouter"
# The default login and its password, which upstream sets to its own name.
LOGIN = "admin"
LOGIN_HASH = "$6$WfhUZJxg4IW5xZL2$tC2AiCMUf0rkvFfrJYqomKSEDFFU/6s6red92qerZC9qX0YdJkwhmoKvzKOvdk939PexkQc5Cj5iRvlB/342B1"
# "/" inside the live-build chroot; hack/test-debrand-hook.sh points it at an
# unpacked vyos-1x package instead.
ROOT = os.environ.get("DEBRAND_ROOT", "/")


def at(path):
    return os.path.join(ROOT, path.lstrip("/"))


def edit(path, replacements):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    for old, new, count in replacements:
        found = text.count(old)
        if found != count:
            sys.exit(f"E: {path}: expected {count} of {old!r}, found {found}")
        text = text.replace(old, new)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def edit_re(path, pattern, new, count):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    text, found = re.subn(pattern, lambda _: new, text, flags=re.S)
    if found != count:
        sys.exit(f"E: {path}: expected {count} of /{pattern}/, found {found}")
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def drop_bytecode(module_path):
    """A stale .pyc still carries the old strings, so remove it with the edit."""
    d, base = os.path.split(module_path)
    stem = os.path.splitext(base)[0]
    for pyc in glob.glob(os.path.join(d, "__pycache__", f"{stem}.*.pyc")):
        os.remove(pyc)


edit(at("/usr/share/vyos/templates/login/default_motd.j2"), [
    ("Welcome to VyOS!", f"Welcome to {NAME}!", 1),
    ("   . VyOS {{ version_data.version }}", f"   . {NAME} {{{{ version_data.version }}}}", 1),
    ("VyOS is a free software distribution", f"{NAME} is a free software distribution", 1),
])

edit(at("/usr/share/vyos/templates/login/motd_vyos_nonproduction.j2"), [
    ("This VyOS system is not", f"This {NAME} system is not", 1),
])

edit(at("/usr/libexec/vyos/conf_mode/system_login_banner.py"), [
    ("Welcome to VyOS - ", f"Welcome to {NAME} - ", 1),
])

edit(at("/usr/libexec/vyos/op_mode/version.py"), [
    ("Version:          VyOS {{version}}", f"Version:          {NAME} {{{{version}}}}", 1),
])

edit(at("/usr/libexec/vyos/init/vyos-router"), [
    ('"Starting VyOS router"', f'"Starting {NAME}"', 1),
    ('"Stopping VyOS router"', f'"Stopping {NAME}"', 1),
    ('"Mounting VyOS Config"', '"Mounting router config"', 1),
    ('"Un-mounting VyOS Config"', '"Un-mounting router config"', 1),
])

edit(at("/usr/libexec/vyos/services/vyos-http-api-server"), [
    ('title="VyOS API"', f'title="{NAME} API"', 1),
    ("default = 'Welcome to VyOS'", f"default = 'Welcome to {NAME}'", 1),
])

airbag = at("/usr/lib/python3/dist-packages/vyos/airbag.py")
edit(airbag, [
    ("Image version:    VyOS {version}", f"Image version:    {NAME} {{version}}", 1),
    ("VyOS had an issue completing a command.", f"{NAME} had an issue completing a command.", 1),
    ("while using VyOS.", f"while using {NAME}.", 1),
])
# The upstream instructions send the reader to VyOS support, downloads and
# community channels, none of which covers this image.
edit_re(
    airbag,
    r'INSTRUCTIONS = """\\\n.*?\n""".strip\(\)',
    'INSTRUCTIONS = """\\\n'
    f"- Report the problem at {REPO_URL}/issues\n"
    "- Make sure you are running the latest release available at:\n"
    f"  {REPO_URL}/releases\n"
    '""".strip()',
    1,
)
drop_bytecode(airbag)

grub = at("/usr/lib/python3/dist-packages/vyos/system/grub.py")
edit(grub, [
    ("id: str = 'VyOS'", f"id: str = '{NAME}'", 1),
])
drop_bytecode(grub)

edit(at("/usr/share/vyos/templates/grub/grub_compat.j2"), [
    ("### Generated by VyOS image-tools", "### Generated by image-tools", 1),
    ("{% if mode == 'normal' -%}\n    VyOS\n", f"{{% if mode == 'normal' -%}}\n    {NAME}\n", 1),
])

# The default NTP servers are run by the VyOS project for its own images.
edit(at("/usr/share/vyos/config.boot.default"), [
    ('host-name "vyos"', 'host-name "barerouter"', 1),
    ("server time1.vyos.net {", "server 0.pool.ntp.org {", 1),
    ("server time2.vyos.net {", "server 1.pool.ntp.org {", 1),
    ("server time3.vyos.net {", "server 2.pool.ntp.org {", 1),
    ("user vyos {", f"user {LOGIN} {{", 1),
])
edit_re(at("/usr/share/vyos/config.boot.default"),
        r'encrypted-password "[^"]*"', f'encrypted-password "{LOGIN_HASH}"', 1)

# Everything else that names the default login: the password the CLI warns
# about, the account the boot loader recreates when the configuration fails to
# load, the prompts and config path of `install image`, and the hostname a
# configuration without one gets.
auth = at("/usr/lib/python3/dist-packages/vyos/utils/auth.py")
edit(auth, [("DEFAULT_PASSWORD: str = 'vyos'", f"DEFAULT_PASSWORD: str = '{LOGIN}'", 1)])
drop_bytecode(auth)
edit(at("/usr/libexec/vyos/vyos-boot-config-loader.py"), [("'vyos'", f"'{LOGIN}'", 5)])
edit(at("/usr/libexec/vyos/op_mode/image_installer.py"), [
    ('"vyos" user', f'"{LOGIN}" user', 2),
    ("'system', 'login', 'user', 'vyos',", f"'system', 'login', 'user', '{LOGIN}',", 1),
])
edit(at("/usr/libexec/vyos/conf_mode/system_host-name.py"), [
    ("'hostname': 'vyos',", "'hostname': 'barerouter',", 1),
])

# CLI help text. Only `help:` lines are rewritten; command paths and values in
# the same templates are identifiers.
changed = 0
for root in (at("/opt/vyatta/share/vyatta-cfg/templates"), at("/opt/vyatta/share/vyatta-op/templates")):
    for path in glob.glob(os.path.join(root, "**", "node.def"), recursive=True):
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
        out = []
        for line in lines:
            if line.startswith("help:") and "VyOS" in line:
                line = line.replace("VyOS", NAME)
                changed += 1
            out.append(line)
        if out != lines:
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(out)
if changed == 0:
    sys.exit("E: no CLI help text mentioned VyOS; the template layout has moved")
print(f"I: rewrote {changed} CLI help lines")

# The message `configure` prints to root names the product.
ROOT_MSG = ("administrator level VyOS user", "administrator level user")
edit(at("/opt/vyatta/share/vyatta-op/templates/configure/node.def"), [ROOT_MSG + (1,)])

# The CLI reads help, completion and defaults from generated caches as well as
# from the templates, so the same strings are rewritten there. JSON caches are
# walked by key, so a value that happens to contain the name elsewhere, such as
# a path, is left alone.
def rename_json(path):
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
    counts = {"help": 0, "default": 0, "command": 0}

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if isinstance(v, str) and "VyOS" in v:
                    if k in ("help", "help_text"):
                        o[k] = v.replace("VyOS", NAME)
                        counts["help"] += 1
                    elif k == "default_value" and v == "VyOS":
                        o[k] = NAME
                        counts["default"] += 1
                    elif k == "command" and ROOT_MSG[0] in v:
                        o[k] = v.replace(*ROOT_MSG)
                        counts["command"] += 1
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(doc)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, separators=(",", ":"))
    return counts


c = rename_json(at("/usr/share/vyos/op_cache.json"))
if c["help"] == 0 or c["command"] != 1:
    sys.exit(f"E: op_cache.json: unexpected rewrite counts {c}")
c = rename_json(at("/usr/share/vyos/reftree.cache"))
if c["help"] == 0 or c["default"] != 1:
    sys.exit(f"E: reftree.cache: unexpected rewrite counts {c}")

# The same caches as Python literals, used by the op-mode and config readers.
HELP_TEXT = re.compile(r"('help_text': ')((?:[^'\\]|\\.)*)'")


def rename_help_text(m):
    return m.group(1) + m.group(2).replace("VyOS", NAME) + "'"


op_cache = at("/usr/lib/python3/dist-packages/vyos/xml_ref/op_cache.py")
with open(op_cache, encoding="utf-8") as f:
    text = f.read()
before = text.count("VyOS")
text = HELP_TEXT.sub(rename_help_text, text)
if text.count(ROOT_MSG[0]) != 1:
    sys.exit(f"E: {op_cache}: expected one {ROOT_MSG[0]!r}")
text = text.replace(*ROOT_MSG)
if before == 0 or "VyOS" in text:
    sys.exit(f"E: {op_cache}: {text.count('VyOS')} of {before} mentions left after the rewrite")
with open(op_cache, "w", encoding="utf-8") as f:
    f.write(text)
drop_bytecode(op_cache)

cfg_cache = at("/usr/lib/python3/dist-packages/vyos/xml_ref/pkg_cache/vyos_1x_cache.py")
edit(cfg_cache, [("'default_value': 'VyOS'", f"'default_value': '{NAME}'", 1)])
drop_bytecode(cfg_cache)

eula = at("/usr/share/vyos/EULA")
if not os.path.exists(eula):
    sys.exit("E: /usr/share/vyos/EULA is missing; debrand-tree.py did not place the notice")
with open(eula, encoding="utf-8") as f:
    if "END USER LICENSE AGREEMENT" in f.read().upper():
        sys.exit("E: /usr/share/vyos/EULA is still the VyOS EULA")

print("I: image debranded")
